{
  "name": "codex-systemone-router",
  "version": "0.1.1",
  "description": "Local difficulty routing for Codex subagents",
  "type": "module",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "bin": {
    "codex-systemone-router": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "templates/",
    "config.example.yaml",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "IMPLEMENTATION.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "benchmark": "tsx benchmark/report.ts",
    "replay": "tsx benchmark/replay.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowvil/codex-systemone-router.git"
  },
  "homepage": "https://github.com/snowvil/codex-systemone-router#readme",
  "bugs": {
    "url": "https://github.com/snowvil/codex-systemone-router/issues"
  },
  "keywords": [
    "codex",
    "ollaya",
    "kev",
    "routing",
    "subagents"
  ]
}
